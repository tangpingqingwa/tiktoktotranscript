# Copy to /etc/tiktoktotranscript.env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Live ClipAPI origin. Leave unset until cutover. Default in code is
# https://api.clipapi.dev (placeholder). CI unsets this.
# CLIPAPI_BASE=https://api.clipapi.dev

# Dedicated ClipAPI service key for this site. Required to call live ClipAPI.
# CLIPAPI_KEY=

# Public ClipAPI marketing origin for the footer CTA (SPEC §8 / BUILD §6).
# CLIPAPI_PUBLIC_ORIGIN=https://api.clipapi.dev

# Canonical site origin used in <link rel="canonical"> and sitemap.
# PUBLIC_ORIGIN=https://tiktoktotranscript.com

# Optional AdSense publisher id. Ads.txt stays a placeholder until set.
# ADSENSE_CLIENT=
